---
// Badges de descarga de la app Kaixo (iOS App Store + Android próximamente).
// Reutilizable: footer y home. Flag/URL en src/lib/appstore.ts.
import { t } from '../../i18n/ui';
import type { LocaleCode } from '../../i18n/config';
import { APP_STORE_URL, IOS_LIVE, PLAY_STORE_URL, ANDROID_LIVE } from '../../lib/appstore';
import { appStoreBadge, playStoreBadge } from '../../lib/store-badges';

interface Props { locale: LocaleCode; }
const { locale } = Astro.props;
const comingSoon = t(locale, 'levels.upcoming');
---
<div class="app-badges">
  {IOS_LIVE && (
    <a href={APP_STORE_URL} class="badge-link" rel="noopener" aria-label="Download on the App Store">
      <img src={appStoreBadge(locale)} alt="App Store" width="135" height="45" loading="lazy" />
    </a>
  )}
  {!IOS_LIVE && (
    <span class="store-pill"><span class="os">iOS</span><span class="soon">{comingSoon}</span></span>
  )}
  {ANDROID_LIVE && (
    <a href={PLAY_STORE_URL} class="badge-link play" rel="noopener" aria-label="Get it on Google Play">
      <img src={playStoreBadge(locale)} alt="Google Play" width="151" height="45" loading="lazy" />
    </a>
  )}
  {!ANDROID_LIVE && (
    <a class="store-pill beta" href={`/${locale}/android/`}><span class="os">Android</span><span class="soon">{t(locale, 'beta.badge')}</span></a>
  )}
</div>

<style>
  .app-badges { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-3); }
  .badge-link { display: inline-flex; }
  .badge-link img { display: block; height: 45px; width: auto; }
  /* Las insignias de Google vienen con ~25 % de margen transparente de fábrica y
     además en dos generaciones distintas (67 % y 77 % de logo visible), así que
     ninguna altura única las igualaba con la de Apple. Se les ha recortado ese
     margen —sin tocar el dibujo— y ahora ambas se pintan al mismo alto: el aire
     alrededor lo pone el gap de la fila. */
  .badge-link.play img { height: 45px; }
  .store-pill {
    display: inline-flex; align-items: center; gap: var(--s-2);
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--c-border-strong);
    border-radius: 999px;
    font-size: 0.8rem; color: var(--c-text-muted);
  }
  .store-pill .os { font-weight: 600; color: var(--c-text); }
  .store-pill .soon { opacity: 0.85; }
  a.store-pill.beta { text-decoration: none; border-color: var(--c-green); transition: background .15s; }
  a.store-pill.beta:hover { background: var(--c-green-soft); }
</style>
