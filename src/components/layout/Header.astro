---
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';
import { LANGUAGES, type LocaleCode } from '../../i18n/config';
import { destinoIdiomaDe } from '../../lib/alternates';
import MobileDrawer from './MobileDrawer.svelte';

interface Props { locale: LocaleCode; }
const { locale } = Astro.props;

// Nombre corto para el botón móvil: sin el paréntesis (Occitan (aranés) → Occitan).
const langName = LANGUAGES[locale].name.replace(/\s*\([^)]*\)\s*$/, '');

// El globo lleva al selector recordando la página actual (?from=), para que al
// elegir idioma se vuelva AQUÍ en el nuevo idioma y no quede uno en el selector.
const here = Astro.url.pathname;
const onPicker = here.endsWith('/idioma/');
const langHref = onPicker ? `/${locale}/idioma/` : `/${locale}/idioma/?from=${encodeURIComponent(here)}`;

// No todos los idiomas tienen A2 (el dariya solo A1): sin enlace a una página que no existe.
const conA2 = (await getCollection('levels')).some((l) => l.id === `${locale}/a2`);

// Desplegable de idioma de escritorio: cada idioma lleva a esta misma página en
// ese idioma, o a la más cercana que exista (igual que el selector del footer).
const idiomas = await Promise.all(
  Object.values(LANGUAGES)
    .filter((l) => l.status === 'active' || l.status === 'beta')
    .map(async (l) => ({ ...l, href: await destinoIdiomaDe(here, l.code) })),
);

type NavItem = { href: string; label?: string; key?: 'nav.home' | 'nav.about' | 'nav.language' | 'nav.progress' | 'hiz.title' };
// `satisfies` sobre el literal: la anotación de navItems no llega al array a través de
// .filter(), y sin tipo contextual 'nav.home' se ensanchaba a string (ya no era StringKey).
const navItems: NavItem[] = ([
  { href: `/${locale}/`, key: 'nav.home' },
  { href: `/${locale}/a1/`, label: 'A1' },
  { href: `/${locale}/a2/`, label: 'A2' },
  { href: `/${locale}/hiztegia/`, key: 'hiz.title' },
  { href: `/${locale}/progreso/`, key: 'nav.progress' },
] satisfies NavItem[]).filter((i) => i.href !== `/${locale}/a2/` || conA2);
---
<header class="site-header">
  <div class="container-wide row">
    <a class="brand" href={`/${locale}/`}>
      <svg viewBox="-100 -100 200 200" width="28" height="28" aria-hidden="true">
        <g>
          <path d="M0 0 C 30 -10, 60 -30, 80 -60 C 60 -30, 30 -5, 0 0 Z" transform="rotate(0)" fill="currentColor"/>
          <path d="M0 0 C 30 -10, 60 -30, 80 -60 C 60 -30, 30 -5, 0 0 Z" transform="rotate(90)" fill="currentColor"/>
          <path d="M0 0 C 30 -10, 60 -30, 80 -60 C 60 -30, 30 -5, 0 0 Z" transform="rotate(180)" fill="currentColor"/>
          <path d="M0 0 C 30 -10, 60 -30, 80 -60 C 60 -30, 30 -5, 0 0 Z" transform="rotate(270)" fill="currentColor"/>
        </g>
      </svg>
      <span class="brand-text">
        <span class="brand-name">{t(locale, 'site.name')}</span>
        <span class="brand-by">By Crintech Studios</span>
      </span>
    </a>
    <nav class="primary-nav" aria-label="primary">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href}>{item.label ?? (item.key ? t(locale, item.key) : item.href)}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="lang-mobile" href={langHref} aria-label="Cambiar idioma / Change language">
      <svg class="globe" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0 -18" />
      </svg>
      <span class="lang-name">{langName}</span>
      <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
    </a>
    {/* Escritorio: globo + idioma; si no cabe (pantallas intermedias, plegables
        girados), solo el globo. Al pulsarlo despliega los idiomas. */}
    <details class="lang-menu">
      <summary aria-label={`${t(locale, 'nav.language')}: ${langName}`}>
        <svg class="globe" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18" />
          <path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0 -18" />
        </svg>
        <span class="lang-label">
          <span class="lang-name">{langName}</span>
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </span>
      </summary>
      <ul class="lang-list">
        {/* dir/lang en el nombre, no en el enlace: así todos se alinean con la página. */}
        {idiomas.map((l) => (
          <li><a href={l.href} aria-current={l.code === locale ? 'true' : undefined}><span lang={l.code} dir={l.dir}>{l.name}</span>{l.latin && <span class="latin" lang="en">{l.latin}</span>}</a></li>
        ))}
      </ul>
    </details>
    <MobileDrawer client:load locale={locale} {conA2} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    /* Se pega bajo el aviso beta si lo hay (var = 0 cuando no). */
    inset-block-start: var(--beta-banner-h, 0px);
    /* No backdrop-filter: crea containing block que atrapa al drawer móvil.
       Para mantener el efecto, sería necesario portalar el drawer a body. */
    background: rgba(255, 255, 255, 0.96);
    border-block-end: 1px solid var(--c-border);
    z-index: 50;
    /* PWA en iPhone con status-bar translúcida: empuja el header bajo el
       notch. env() vale 0 en navegadores sin notch, así que no afecta a nadie más.
       Consume el notch SOLO cuando no hay aviso beta: si el banner está presente
       ya absorbió el safe-area y el header queda anclado bajo él
       (--beta-banner-h ≥ inset), así que restarlo da 0 y evita una doble franja. */
    padding-block-start: max(0px, calc(env(safe-area-inset-top, 0px) - var(--beta-banner-h, 0px)));
    padding-inline: env(safe-area-inset-left, 0px) env(safe-area-inset-right, 0px);
  }
  .row {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    block-size: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    color: var(--c-text);
  }
  .brand svg { color: var(--c-red); flex-shrink: 0; }
  .brand-text { display: inline-flex; flex-direction: column; line-height: 1.1; }
  .brand-name { font-weight: 700; font-size: 1rem; }
  .brand-by {
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--c-text-muted);
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
  }
  .primary-nav { margin-inline-start: auto; }
  .primary-nav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--s-5);
  }
  .primary-nav a {
    text-decoration: none;
    color: var(--c-text);
    font-weight: 500;
    padding-block: var(--s-2);
  }
  .primary-nav a:hover { color: var(--c-red); }

  /* Botón de idioma en móvil: junto al hamburguesa, globe + idioma actual +
     flecha. En escritorio el cambio de idioma vive en la nav/footer. */
  .lang-mobile {
    display: none;
    align-items: center;
    gap: var(--s-2);
    margin-inline-start: auto;
    /* Junto a la hamburguesa: recorta el hueco de la fila (s-5) a s-1. */
    margin-inline-end: calc(var(--s-1) - var(--s-5));
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--c-border);
    border-radius: var(--r-pill);
    color: var(--c-text);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    transition: border-color var(--m-base) var(--ease-out), color var(--m-base) var(--ease-out);
  }
  .lang-mobile .globe { color: var(--c-red); flex-shrink: 0; }
  .lang-mobile .chev { color: var(--c-text-muted); flex-shrink: 0; }
  .lang-mobile .lang-name {
    display: block;
    min-inline-size: 0;
    max-inline-size: 10ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lang-mobile:hover { border-color: var(--c-red); color: var(--c-red); }
  [dir="rtl"] .lang-mobile { margin-inline-start: auto; }

  /* Desplegable de idioma de escritorio. Brand, nav y globo no encogen: si no
     caben, la fila desborda, el guion lo detecta y pasa a «solo globo». */
  .brand, .primary-nav { flex-shrink: 0; }
  .primary-nav a { white-space: nowrap; }
  .lang-menu { position: relative; flex-shrink: 0; }
  .lang-menu > summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--c-border);
    border-radius: var(--r-pill);
    color: var(--c-text);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    transition: border-color var(--m-base) var(--ease-out), color var(--m-base) var(--ease-out);
  }
  .lang-menu > summary::-webkit-details-marker { display: none; }
  .lang-menu > summary:hover,
  .lang-menu[open] > summary { border-color: var(--c-red); color: var(--c-red); }
  .lang-menu .globe { color: var(--c-red); flex-shrink: 0; }
  .lang-menu .lang-label { display: inline-flex; align-items: center; gap: var(--s-2); }
  .lang-menu .chev { color: var(--c-text-muted); transition: transform var(--m-base) var(--ease-out); }
  .lang-menu[open] .chev { transform: rotate(180deg); }
  /* Sin sitio para el nombre: solo el globo, en un círculo del mismo alto. */
  :global(.site-header.lang-solo-globo) .lang-label { display: none; }
  :global(.site-header.lang-solo-globo) .lang-menu > summary { padding: var(--s-2); }
  /* Ni el globo solo cabe: la cabecera pasa al formato de móvil. */
  :global(.site-header.cabecera-estrecha) .primary-nav,
  :global(.site-header.cabecera-estrecha) .lang-menu,
  :global(.site-header.cabecera-estrecha) .brand-by { display: none; }
  :global(.site-header.cabecera-estrecha) .lang-mobile { display: inline-flex; }
  .lang-list {
    position: absolute;
    inset-block-start: calc(100% + var(--s-2));
    inset-inline-end: 0;
    z-index: 60;
    margin: 0;
    padding: var(--s-3);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, max-content);
    gap: 2px var(--s-2);
    max-inline-size: calc(100vw - 2 * var(--s-4));
    max-block-size: calc(100dvh - var(--beta-banner-h, 0px) - 64px - var(--s-5));
    overflow: auto;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-card-deep);
  }
  .lang-list a {
    display: block;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    color: var(--c-text-muted);
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--m-base) var(--ease-out), background var(--m-base) var(--ease-out);
  }
  .lang-list a:hover { color: var(--c-red); background: var(--c-bg-alt); }
  .lang-list a[aria-current='true'] { color: var(--c-red); font-weight: 600; }
  .lang-list .latin { margin-inline-start: 0.4em; font-size: 0.8em; color: var(--c-text-dim); }

  @media (max-width: 768px) {
    .primary-nav { display: none; }
    .lang-menu { display: none; }
    .lang-mobile { display: inline-flex; }
    /* Libera espacio para el botón de idioma; el lema sigue en escritorio y footer. */
    .brand-by { display: none; }
  }
  /* Pantallas muy estrechas: acorta más el nombre para que nunca se desborde. */
  @media (max-width: 380px) {
    .lang-mobile .lang-name { max-inline-size: 7ch; }
    .lang-mobile { padding-inline: var(--s-2); gap: var(--s-1); }
  }
</style>

<script>
  // Globo de idioma en escritorio: si globo + nombre no caben en la cabecera
  // (pantallas intermedias, plegables girados, idiomas con menú largo), se
  // queda solo el globo. Se mide en vez de fijar anchos porque cada idioma
  // tiene etiquetas de menú de distinta longitud.
  // Y si ni el globo solo cabe, la cabecera pasa al formato de móvil
  // (hamburguesa + botón de idioma) en vez de salirse de la pantalla.
  const SOLO = 'lang-solo-globo';
  const ESTRECHA = 'cabecera-estrecha';
  let observador: ResizeObserver | undefined;

  function ajusta(cabecera: HTMLElement) {
    const fila = cabecera.querySelector<HTMLElement>('.row');
    if (!fila) return;
    const desborda = () => fila.scrollWidth > fila.clientWidth + 1;
    cabecera.classList.remove(SOLO, ESTRECHA);
    if (desborda()) cabecera.classList.add(SOLO);
    if (desborda()) cabecera.classList.add(ESTRECHA);
  }

  function engancha() {
    const cabecera = document.querySelector<HTMLElement>('.site-header');
    if (!cabecera) return;
    observador?.disconnect();
    observador = new ResizeObserver(() => ajusta(cabecera));
    observador.observe(cabecera);
    ajusta(cabecera);
    document.fonts?.ready.then(() => ajusta(cabecera));
  }

  // page-load salta al cargar y tras cada navegación del ClientRouter.
  document.addEventListener('astro:page-load', engancha);

  // El desplegable se cierra al pulsar fuera o con Escape.
  document.addEventListener('click', (e) => {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('.lang-menu[open]')) {
      if (!menu.contains(e.target as Node)) menu.open = false;
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('.lang-menu[open]')) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
</script>
