---
import RootLayout from '../../layouts/RootLayout.astro';
import { ACTIVE_LOCALES, type LocaleCode } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { PLAY_STORE_URL } from '../../lib/appstore';

import { ajusta, sinMarcado, minimoDescripcion } from '../../lib/seo-texto.mjs';
export async function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
const GROUP = 'https://groups.google.com/g/crintechstudios';
const OPTIN = 'https://play.google.com/apps/testing/pro.crintech.euskera.twa';
const descripcion = ajusta(sinMarcado(t(locale, 'beta.live.d')), t(locale, 'site.tagline'), minimoDescripcion(locale));
---
<RootLayout locale={locale} title={t(locale, 'beta.title')} description={descripcion}>
  {/* Esta página promociona Google Play, así que dentro de la app de iOS no
      puede verse: Apple rechaza por la Guideline 2.3.10 cualquier mención a
      otra tienda. La barrera es la clase app-promo, que la regla global
      .is-native-app .app-promo la oculta por completo.

      🔴 NO usar <WebOnly> aquí. Lo estuvo del 30-ago al 7-sep-2026 y salió
      caro: <WebOnly> emite dentro de un <template>, que ningún rastreador sin
      JavaScript llega a ver, así que para ellos la página estaba VACÍA (cero
      caracteres de texto) y Search Console la daba por desactualizada. La
      diferencia con las insignias del pie o de la portada es que aquellas SÍ
      viven en páginas que se abren dentro de la app; a esta no se llega desde
      la app (la píldora que enlazaba aquí dejó de pintarse al publicar en
      Google Play), así que le basta la clase. */}
  <article class="container prose app-promo">
    <div class="live">
      <h1>{t(locale, 'beta.live.t')}</h1>
      <p set:html={t(locale, 'beta.live.d')} />
      <a class="btn btn-primary" href={PLAY_STORE_URL} rel="noopener">{t(locale, 'beta.live.cta')}</a>
    </div>

    <h2 class="beta-h">{t(locale, 'beta.live.beta')}</h2>
    <p class="lead" set:html={t(locale, 'beta.lead')} />

    <div class="ctas">
      <a class="btn btn-primary" href={GROUP} rel="noopener">{t(locale, 'beta.cta.group')}</a>
      <a class="btn btn-secondary" href={OPTIN} rel="noopener">{t(locale, 'beta.cta.optin')}</a>
    </div>

    <h2>{t(locale, 'beta.step1.t')}</h2>
    <p set:html={t(locale, 'beta.step1.d')} />
    <p><a class="link" href={GROUP} rel="noopener">{GROUP}</a></p>

    <h2>{t(locale, 'beta.step2.t')}</h2>
    <p set:html={t(locale, 'beta.step2.d')} />
    <p><a class="link" href={OPTIN} rel="noopener">{OPTIN}</a></p>

    <h2>{t(locale, 'beta.step3.t')}</h2>
    <p set:html={t(locale, 'beta.step3.d')} />

    <div class="warn">
      <h2>{t(locale, 'beta.wait.t')}</h2>
      <p set:html={t(locale, 'beta.wait.d')} />
    </div>

    <h2>{t(locale, 'beta.faq.t')}</h2>
    <h3>{t(locale, 'beta.faq1.q')}</h3>
    <p set:html={t(locale, 'beta.faq1.a')} />
    <h3>{t(locale, 'beta.faq2.q')}</h3>
    <p set:html={t(locale, 'beta.faq2.a')} />
    <h3>{t(locale, 'beta.faq3.q')}</h3>
    <p set:html={t(locale, 'beta.faq3.a')} />

    <p class="why" set:html={t(locale, 'beta.why')} />
    <p class="thanks">{t(locale, 'beta.thanks')}</p>
  </article>
</RootLayout>

<style is:inline>
  /* 🔴 INLINE A PROPÓSITO, no por descuido. Esta es la única barrera que impide
     que una página llena de Google Play se pinte dentro de la app de iOS, y
     Apple rechaza por eso (Guideline 2.3.10). La misma regla existe en el
     layout, pero acaba en una hoja de estilo EXTERNA: si esa hoja no llegara
     —red mala, un bloqueo de IP como los que ya nos comimos—, la página se
     pintaría igual y fallaríamos en ABIERTO. Inline viaja dentro del propio
     HTML: si llega la página, llega la regla. */
  .is-native-app .app-promo { display: none !important; }
</style>

<style>
  .prose { padding-block: var(--s-6); max-width: 760px; }
  .prose h1 { margin: 0 0 var(--s-3); }
  .lead { font-size: 1.1rem; color: var(--c-text); margin: 0 0 var(--s-5); line-height: 1.6; }
  .ctas { display: flex; gap: var(--s-3); flex-wrap: wrap; margin-block-end: var(--s-6); }
  .ctas .btn { text-decoration: none; }
  .prose h2 { margin-block: var(--s-6) var(--s-2); font-size: 1.2rem; }
  .prose h3 { margin-block: var(--s-4) var(--s-1); font-size: 1rem; }
  .prose p { margin: 0 0 var(--s-3); line-height: 1.7; }
  .link { color: var(--c-red); word-break: break-all; font-size: 0.9rem; }
  .warn {
    margin-block: var(--s-6); padding: var(--s-4) var(--s-5);
    border: 1px solid var(--c-border-strong); border-left: 4px solid var(--c-red);
    border-radius: var(--r-md); background: var(--c-bg-alt);
  }
  .warn h2 { margin-block-start: 0; }
  .why, .thanks { color: var(--c-text-muted); font-size: 0.95rem; }
</style>
