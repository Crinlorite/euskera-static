---
import RootLayout from '../../layouts/RootLayout.astro';
import { ACTIVE_LOCALES, type LocaleCode } from '../../i18n/config';
import { t, tf } from '../../i18n/ui';

export async function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
---
<RootLayout locale={locale} title={t(locale, 'priv.title')}>
  <article class="container prose">
    <h1>{t(locale, 'priv.title')}</h1>
    <p class="updated">{t(locale, 'priv.updated')}</p>

    <p set:html={t(locale, 'priv.intro')} />

    <h2>{t(locale, 'priv.s1.title')}</h2>
    <p>{t(locale, 'priv.s1.intro')}</p>
    <ul>
      <li set:html={t(locale, 'priv.s1.li1')} />
      <li set:html={t(locale, 'priv.s1.li2')} />
      <li set:html={t(locale, 'priv.s1.li3')} />
      <li set:html={t(locale, 'priv.s1.li4')} />
    </ul>

    <h2>{t(locale, 'priv.s2.title')}</h2>
    <p set:html={t(locale, 'priv.s2.p1')} />
    <p set:html={t(locale, 'priv.s2.p2')} />
    <p set:html={t(locale, 'priv.s2.p3')} />

    <h2>{t(locale, 'priv.s3.title')}</h2>
    <p set:html={t(locale, 'priv.s3.p1')} />
    <p set:html={t(locale, 'priv.s3.p2')} />

    <h2>{t(locale, 'priv.s4.title')}</h2>
    <p>{t(locale, 'priv.s4.intro')}</p>
    <ul>
      <li set:html={t(locale, 'priv.s4.li1')} />
      <li set:html={t(locale, 'priv.s4.li2')} />
      <li set:html={t(locale, 'priv.s4.li3')} />
      <li set:html={t(locale, 'priv.s4.li4')} />
    </ul>

    <h2>{t(locale, 'priv.s5.title')}</h2>
    <p set:html={tf(locale, 'priv.s5.intro', locale)} />
    <ul>
      <li set:html={t(locale, 'priv.s5.li1')} />
      <li set:html={t(locale, 'priv.s5.li2')} />
      <li set:html={t(locale, 'priv.s5.li3')} />
      <li set:html={t(locale, 'priv.s5.li4')} />
    </ul>
    <p set:html={t(locale, 'priv.s5.outro')} />

    <h2>{t(locale, 'priv.s6.title')}</h2>
    <p set:html={t(locale, 'priv.s6.body')} />

    <h2>{t(locale, 'priv.s7.title')}</h2>
    <p set:html={t(locale, 'priv.s7.body')} />

    <h2>{t(locale, 'priv.s8.title')}</h2>
    <p set:html={t(locale, 'priv.s8.body')} />

    <h2>{t(locale, 'priv.s9.title')}</h2>
    <p>
      Crintech Studios &mdash; <a href="https://crintech.pro" rel="noopener">crintech.pro</a><br />
      Email: <a href="mailto:kaixo@crintech.pro">kaixo@crintech.pro</a><br />
      Repositorio: <a href="https://github.com/Crinlorite/euskera-static" rel="noopener">github.com/Crinlorite/euskera-static</a>
    </p>
  </article>
</RootLayout>

<style>
  .prose { padding-block: var(--s-6); max-width: 800px; }
  .prose h1 { margin: 0 0 var(--s-2); }
  .prose .updated { color: var(--c-text-muted); font-size: 0.9rem; margin: 0 0 var(--s-6); }
  .prose h2 { margin-block: var(--s-6) var(--s-2); font-size: 1.25rem; }
  .prose p { margin: 0 0 var(--s-3); line-height: 1.7; }
  .prose ul { padding-inline-start: var(--s-5); display: grid; gap: var(--s-2); margin: 0 0 var(--s-3); }
  .prose code { background: var(--c-bg-alt); padding: 0.1em 0.4em; border-radius: 4px; font-size: 0.9em; }
</style>
