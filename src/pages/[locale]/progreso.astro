---
import { getCollection } from 'astro:content';
import RootLayout from '../../layouts/RootLayout.astro';
import ProgressDashboard from '../../components/progress/ProgressDashboard.svelte';
import ProgressByUnit from '../../components/progress/ProgressByUnit.svelte';
import Achievements from '../../components/progress/Achievements.svelte';
import LessonIndexData from '../../components/progress/LessonIndexData.astro';
import { indexLessons } from '../../lib/lesson-index';
import { ACTIVE_LOCALES, type LocaleCode } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { LOCKED_PATHS } from '../../lib/locked.mjs';

export async function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };

// Datos por unidad (para ProgressByUnit + para evaluator de logros), de TODOS los
// niveles abiertos del idioma: hoy A1 y A2 (B1+ de castellano quedan fuera por el
// candado). Antes solo se miraba el A1 y el A2 no contaba ni en progreso ni en logros.
const allUnits = await getCollection('units');
const allLessons = await getCollection('lessons');
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const levels = [...new Set(allUnits.filter((u) => u.id.startsWith(`${locale}/`)).map((u) => u.id.split('/')[1]))]
  .filter((l) => !LOCKED_PATHS.includes(l))
  .sort();
const unitsByLevelEntries = levels.map((l) => ({
  level: l,
  units: allUnits.filter((u) => u.id.startsWith(`${locale}/${l}/`)).sort(byOrder),
}));

const lessonsByUnit: Record<string, string[]> = {};
const openLessons: Array<(typeof allLessons)[number]> = [];
for (const { level, units } of unitsByLevelEntries) {
  for (const u of units) {
    const lessons = allLessons
      .filter((l) => l.id.startsWith(`${locale}/${level}/${u.data.code}/`))
      .sort(byOrder);
    openLessons.push(...lessons);
    lessonsByUnit[u.data.id] = lessons.map((l) => l.data.id);
  }
}
// Ejercicios y corregibles de todas las lecciones abiertas (A1 y A2): con ellos
// el cliente deriva los cuatro estados. Lleva además título y código de cada
// lección: va una sola vez en la página (LessonIndexData) y de ahí lo leen el
// resumen, el progreso por unidad (títulos y enlaces de los puntos) y los logros.
// Su ORDEN de inserción es el del currículo (nivel → unidad → lección): el
// resumen lo usa como orden para «Continuar»; no reordenar.
const index = indexLessons(openLessons, { titles: true, codes: true });

// Unidades (sin lecciones) para la tarjeta «Continuar» del resumen.
const unitsMeta = unitsByLevelEntries.flatMap(({ level, units }) =>
  units.map((u) => ({ id: u.data.id, code: u.data.code, title: u.data.title, order: u.data.order, level })),
);

const unitsForComponentByLevel = unitsByLevelEntries.map(({ level, units }) => ({
  level,
  units: units.map((u) => ({
    id: u.data.id,
    code: u.data.code,
    title: u.data.title,
    order: u.data.order,
    lessonIds: lessonsByUnit[u.data.id] ?? [],
  })),
}));

// Para el evaluator de logros — units por nivel
const unitsByLevel: Record<string, { unitIds: string[] }> = Object.fromEntries(
  unitsByLevelEntries.map(({ level, units }) => [level, { unitIds: units.map((u) => u.data.id) }]),
);

// Títulos de unidad en el idioma de la página, para los logros de maestría.
const unitTitles = Object.fromEntries(
  unitsByLevelEntries.flatMap(({ units }) => units.map((u) => [u.data.id, u.data.title])),
);

const descripcion = t(locale, 'site.description');
---
<RootLayout locale={locale} title={t(locale, 'nav.progress')} description={descripcion}>
  <article class="container progreso">
    <header class="page-head">
      <p class="eyebrow">{t(locale, 'progress.path')}</p>
      <h1 class="display page-title">{t(locale, 'nav.progress')}</h1>
    </header>

    <LessonIndexData index={index} />
    <!-- El resumen se pinta en cliente (el progreso vive en localStorage). Su hueco
         se reserva desde el HTML para que, al aparecer, no empuje la página: el
         script mira solo si hay progreso guardado y elige el alto (s0: tarjeta de
         empezar; s1: tarjeta, cifras, repaso y copia). Va en línea y antes de
         pintar; con ClientRouter se vuelve a ejecutar en cada visita. -->
    <div class="dash" data-dash="s0">
      <script is:inline data-astro-rerun>(function(){var d=document.querySelector('[data-dash]');if(!d)return;try{if(localStorage.getItem('euskera-static.progress.v1'))d.dataset.dash='s1'}catch(e){}})()</script>
      <ProgressDashboard client:load locale={locale} units={unitsMeta} />
    </div>

    {unitsForComponentByLevel.map(({ level, units }, i) => (
      <ProgressByUnit
        client:load
        units={units}
        levelCode={level}
        locale={locale}
        headingId={`progress-by-unit-${level}`}
        eyebrow={i === 0}
        collapsible={i > 0}
      />
    ))}

    <Achievements
      client:load
      unitsByLevel={unitsByLevel}
      unitTitles={unitTitles}
      locale={locale}
    />
  </article>
</RootLayout>

<style>
  .progreso { padding-block: var(--s-6) var(--s-8); display: grid; gap: var(--s-7); }
  /* Resumen: piezas juntas (16 px dentro de la sección, 48 entre secciones). Sin
     transform, filter ni contain: los modales del resumen son position: fixed. */
  .dash { display: grid; gap: var(--s-4); align-content: start; }
  /* Alto reservado hasta que el resumen se monta: un poco por debajo del mínimo
     medido en 10 idiomas, para que al montar crezca algo y nunca deje hueco.
     Cortes: las cifras pasan de 4 a 3 columnas hacia los 685 px; por debajo de
     541 px el resumen toma una forma fija (ProgressDashboard) y por debajo de
     344 px las cifras van en una sola columna. */
  .dash[data-dash="s0"] { min-block-size: 172px; }
  .dash[data-dash="s1"] { min-block-size: 510px; }
  @media (max-width: 684px) { .dash[data-dash="s1"] { min-block-size: 650px; } }
  @media (max-width: 540px) {
    .dash[data-dash="s0"] { min-block-size: 228px; }
    .dash[data-dash="s1"] { min-block-size: 806px; }
  }
  @media (max-width: 343px) { .dash[data-dash="s1"] { min-block-size: 1130px; } }
  .dash:has(:global(.next-card), :global(.summary)) { min-block-size: 0; }
  .page-head { display: grid; gap: var(--s-2); }
  .page-title {
    font-size: var(--t-h1);
    line-height: 1.05;
    letter-spacing: var(--tr-tight);
    margin: 0;
  }
</style>
