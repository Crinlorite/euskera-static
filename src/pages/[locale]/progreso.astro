---
import { getCollection } from 'astro:content';
import RootLayout from '../../layouts/RootLayout.astro';
import ProgressDashboard from '../../components/progress/ProgressDashboard.svelte';
import ProgressByUnit from '../../components/progress/ProgressByUnit.svelte';
import Achievements from '../../components/progress/Achievements.svelte';
import LessonIndexData from '../../components/progress/LessonIndexData.astro';
import { indexLessons } from '../../lib/lesson-index';
import { ACTIVE_LOCALES, type LocaleCode } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { ACHIEVEMENTS } from '../../lib/achievements';
import { LOCKED_PATHS } from '../../lib/locked.mjs';

export async function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };

// Datos por unidad (para ProgressByUnit + para evaluator de logros), de TODOS los
// niveles abiertos del idioma: hoy A1 y A2 (B1+ de castellano quedan fuera por el
// candado). Antes solo se miraba el A1 y el A2 no contaba ni en progreso ni en logros.
const allUnits = await getCollection('units');
const allLessons = await getCollection('lessons');
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const levels = [...new Set(allUnits.filter((u) => u.id.startsWith(`${locale}/`)).map((u) => u.id.split('/')[1]))]
  .filter((l) => !LOCKED_PATHS.includes(l))
  .sort();
const unitsByLevelEntries = levels.map((l) => ({
  level: l,
  units: allUnits.filter((u) => u.id.startsWith(`${locale}/${l}/`)).sort(byOrder),
}));

const lessonsByUnit: Record<string, string[]> = {};
const lessonInputsByUnit: Record<string, Array<{ id: string; code: string; title: string }>> = {};
const openLessons: Array<(typeof allLessons)[number]> = [];
for (const { level, units } of unitsByLevelEntries) {
  for (const u of units) {
    const lessons = allLessons
      .filter((l) => l.id.startsWith(`${locale}/${level}/${u.data.code}/`))
      .sort(byOrder);
    openLessons.push(...lessons);
    lessonsByUnit[u.data.id] = lessons.map((l) => l.data.id);
    lessonInputsByUnit[u.data.id] = lessons.map((l) => ({ id: l.data.id, code: l.data.code, title: l.data.title }));
  }
}
// Ejercicios y corregibles de todas las lecciones abiertas (A1 y A2): con ellos
// el cliente deriva los cuatro estados. Va una sola vez en la página
// (LessonIndexData) y lo leen el resumen y el progreso por unidad.
const index = indexLessons(openLessons);

const unitsForComponentByLevel = unitsByLevelEntries.map(({ level, units }) => ({
  level,
  units: units.map((u) => ({
    id: u.data.id,
    code: u.data.code,
    title: u.data.title,
    order: u.data.order,
    lessons: lessonInputsByUnit[u.data.id] ?? [],
  })),
}));

// Para el evaluator de logros — units por nivel
const unitsByLevel: Record<string, { unitIds: string[] }> = Object.fromEntries(
  unitsByLevelEntries.map(({ level, units }) => [level, { unitIds: units.map((u) => u.data.id) }]),
);

// Títulos de unidad en el idioma de la página, para los logros de maestría.
const unitTitles = Object.fromEntries(
  unitsByLevelEntries.flatMap(({ units }) => units.map((u) => [u.data.id, u.data.title])),
);

// Catalogo serializable a cliente
const achievementsCatalog = ACHIEVEMENTS;
const descripcion = t(locale, 'site.description');
---
<RootLayout locale={locale} title={t(locale, 'nav.progress')} description={descripcion}>
  <article class="container progreso">
    <header class="page-head">
      <p class="eyebrow">{t(locale, 'progress.path')}</p>
      <h1 class="display page-title">{t(locale, 'nav.progress')}</h1>
    </header>

    <LessonIndexData index={index} />
    <ProgressDashboard client:load locale={locale} />

    {unitsForComponentByLevel.map(({ level, units }) => (
      <ProgressByUnit
        client:load
        units={units}
        levelCode={level}
        locale={locale}
        headingId={`progress-by-unit-${level}`}
      />
    ))}

    <Achievements
      client:load
      catalog={achievementsCatalog}
      lessonsByUnit={lessonsByUnit}
      unitsByLevel={unitsByLevel}
      unitTitles={unitTitles}
      locale={locale}
    />
  </article>
</RootLayout>

<style>
  .progreso { padding-block: var(--s-6) var(--s-8); display: grid; gap: var(--s-7); }
  .page-head { display: grid; gap: var(--s-2); }
  .page-title {
    font-size: var(--t-h1);
    line-height: 1.05;
    letter-spacing: var(--tr-tight);
    margin: 0;
  }
</style>
