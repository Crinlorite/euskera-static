  fr: { title: 'Simulakro sortzailea — examen A1 infini', back: '← A1 · Toutes les unités',
    lead: 'Un examen A1 <strong>différent à chaque fois</strong>, assemblé à l’instant depuis une banque de centaines de questions avec la structure d’une épreuve réelle — <strong>avec entzumena</strong> : audio avec une vraie voix et deux écoutes, comme le jour J. Fais-le d’une traite, sans dictionnaire — et à la fin, appuie sur <em>«Beste simulakro bat sortu»</em> et un autre tombe.' },
  ro: { title: 'Simulakro sortzailea — examen A1 infinit', back: '← A1 · Toate unitățile',
    lead: 'Un examen A1 <strong>diferit de fiecare dată</strong>, asamblat pe loc dintr-o bancă de sute de întrebări cu structura unei probe reale — <strong>cu entzumena</strong>: audio cu voce reală și două ascultări, ca în ziua cea mare. Fă-l dintr-o bucată, fără dicționar — iar la final apasă <em>«Beste simulakro bat sortu»</em> și pică altul.' },
  'pt-BR': { title: 'Simulakro sortzailea — prova A1 infinita', back: '← A1 · Todas as unidades',
    lead: 'Uma prova A1 <strong>diferente a cada vez</strong>, montada na hora a partir de um banco de centenas de perguntas com a estrutura de um exame real — <strong>com entzumena</strong>: áudio com voz real e duas escutas, como no dia de verdade. Faça de uma vez, sem dicionário — e ao terminar, aperte <em>«Beste simulakro bat sortu»</em> e cai outra.' },
  de: { title: 'Simulakro sortzailea — endlose A1-Prüfung', back: '← A1 · Alle Einheiten',
    lead: 'Eine A1-Prüfung, die <strong>jedes Mal anders</strong> ist — im Moment zusammengestellt aus einer Bank mit Hunderten Fragen und der Struktur einer echten Prüfung, <strong>mit entzumena</strong>: Audio mit echter Stimme und zwei Durchläufen, wie am echten Tag. Mach sie in einem Zug, ohne Wörterbuch — und am Ende drückst du <em>«Beste simulakro bat sortu»</em> und die nächste fällt.' },
  it: { title: 'Simulakro sortzailea — esame A1 infinito', back: '← A1 · Tutte le unità',
    lead: 'Un esame A1 <strong>diverso ogni volta</strong>, montato al momento da una banca di centinaia di domande con la struttura di una prova reale — <strong>con entzumena</strong>: audio con voce reale e due ascolti, come il giorno vero. Fallo tutto d’un fiato, senza dizionario — e alla fine premi <em>«Beste simulakro bat sortu»</em> e ne cade un altro.' },
