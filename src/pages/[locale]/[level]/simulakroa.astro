---
// Generador procedural de simulacros — en los 18 idiomas desde el 03-ago-2026.
// El banco por locale (a1.<loc>.json) lo produce scripts/build_bank.py --all:
// items/tarjetas/títulos cosechados del content YA traducido + seeds con overlay.
// El copy de ESTA página vive aquí (es copy de página, no UI compartida).
import RootLayout from '../../../layouts/RootLayout.astro';
import SimulakroGenerator from '../../../components/exercises/SimulakroGenerator.svelte';
import { ACTIVE_LOCALES } from '../../../i18n/config';
import type { LocaleCode } from '../../../i18n/config';

export function getStaticPaths() {
  return ACTIVE_LOCALES.map((code) => ({ params: { locale: code, level: 'a1' } }));
}

const { locale, level } = Astro.params as { locale: LocaleCode; level: string };

type Copy = { title: string; back: string; lead: string };
const COPY: Partial<Record<LocaleCode, Copy>> = {
  es: { title: 'Simulakro sortzailea — examen A1 infinito', back: '← A1 · Todas las unidades',
    lead: 'Un examen A1 <strong>distinto cada vez</strong>, montado al momento desde un banco de cientos de preguntas con la estructura de una prueba real — <strong>con entzumena</strong>: audio con voz real y dos escuchas, como el día de verdad. Hazlo del tirón, sin diccionario — y cuando acabes, pulsa <em>«Beste simulakro bat sortu»</em> y cae otro.' },
  ca: { title: 'Simulakro sortzailea — examen A1 infinit', back: '← A1 · Totes les unitats',
    lead: 'Un examen A1 <strong>diferent cada vegada</strong>, muntat a l’instant des d’un banc de centenars de preguntes amb l’estructura d’una prova real — <strong>amb entzumena</strong>: àudio amb veu real i dues escoltes, com el dia de veritat. Fes-lo d’una tirada, sense diccionari — i en acabar, prem <em>«Beste simulakro bat sortu»</em> i en cau un altre.' },
  gl: { title: 'Simulakro sortzailea — exame A1 infinito', back: '← A1 · Todas as unidades',
    lead: 'Un exame A1 <strong>distinto cada vez</strong>, montado no momento desde un banco de centos de preguntas coa estrutura dunha proba real — <strong>con entzumena</strong>: audio con voz real e dúas escoitas, coma o día de verdade. Faino dunha tirada, sen dicionario — e ao rematar, preme <em>«Beste simulakro bat sortu»</em> e cae outro.' },
  ast: { title: 'Simulakro sortzailea — esame A1 infinitu', back: '← A1 · Toles unidaes',
    lead: 'Un esame A1 <strong>distintu cada vegada</strong>, montáu nel momentu dende un bancu de cientos d’entrugues cola estructura d’una prueba real — <strong>con entzumena</strong>: audiu con voz nativa y dos escuches, como’l día de verdá. Failu del tirón, ensin diccionariu — y al acabar, calca <em>«Beste simulakro bat sortu»</em> y cai otru.' },
  an: { title: 'Simulakro sortzailea — examen A1 infinito', back: '← A1 · Todas as unidatz',
    lead: 'Un examen A1 <strong>diferent cada vegada</strong>, montau a o momento dende un banco de cientos de preguntas con a estructura d’una preba real — <strong>con entzumena</strong>: audio con voz real y dos escuitas, como o día de verdat. Fe-lo d’una tirada, sin diccionario — y en rematar, preta <em>«Beste simulakro bat sortu»</em> y en caye unatro.' },
  oc: { title: 'Simulakro sortzailea — examen A1 infinit', back: '← A1 · Totas las unitats',
    lead: 'Un examen A1 <strong>diferent cada còp</strong>, montat sul moment dempuèi un banc de centenats de questions amb l’estructura d’una espròva reala — <strong>amb entzumena</strong>: àudio amb votz reala e doas escotas, coma lo jorn vertadièr. Fai-lo d’una tirada, sens diccionari — e en acabant, quicha <em>«Beste simulakro bat sortu»</em> e ne tomba un autre.' },
  en: { title: 'Simulakro sortzailea — infinite A1 exam', back: '← A1 · All units',
    lead: 'An A1 exam that is <strong>different every time</strong>, assembled on the spot from a bank of hundreds of questions with the structure of a real test — <strong>with entzumena</strong>: audio with a real voice and two listens, just like the real day. Do it in one go, no dictionary — and when you finish, press <em>«Beste simulakro bat sortu»</em> and another one drops.' },
  ar: { title: 'Simulakro sortzailea — امتحان A1 لا نهائي', back: '← A1 · كل الوحدات',
