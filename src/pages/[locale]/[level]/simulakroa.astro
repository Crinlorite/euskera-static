  pl: { title: 'Simulakro sortzailea — nieskończony egzamin A1', back: '← A1 · Wszystkie działy',
    lead: 'Egzamin A1 <strong>za każdym razem inny</strong>, składany na poczekaniu z banku setek pytań o strukturze prawdziwego testu — <strong>z entzumena</strong>: nagranie z prawdziwym głosem i dwoma odsłuchami, jak w prawdziwy dzień. Zrób go za jednym podejściem, bez słownika — a na końcu naciśnij <em>«Beste simulakro bat sortu»</em> i wypada następny.' },
  'zh-Hans': { title: 'Simulakro sortzailea — 无限 A1 模拟考', back: '← A1 · 全部单元',
    lead: '一份<strong>每次都不一样</strong>的 A1 试卷：从数百道题的题库即时组卷，结构与真实考试一致——<strong>含 entzumena</strong>：真人语音、限听两次，就像真正的考试日。一口气做完，不查词典——做完后按 <em>«Beste simulakro bat sortu»</em>，又是一份新卷。' },
  ja: { title: 'Simulakro sortzailea — 無限 A1 模試', back: '← A1 · 全ユニット',
    lead: '<strong>毎回内容が変わる</strong> A1 試験。数百問のバンクからその場で組み立てられ、構成は本物の試験そのまま——<strong>entzumena 付き</strong>：本物の声の音声を2回まで再生、本番と同じです。辞書なしで一気に解いて、終わったら <em>«Beste simulakro bat sortu»</em> を押せば次の一枚が落ちてきます。' },
  ko: { title: 'Simulakro sortzailea — 무한 A1 모의고사', back: '← A1 · 전체 단원',
    lead: '<strong>매번 다른</strong> A1 시험: 수백 문항의 문제은행에서 즉석으로 조립되며 구조는 실제 시험 그대로 — <strong>entzumena 포함</strong>: 실제 목소리 음성과 2회 듣기, 진짜 시험날처럼. 사전 없이 한 번에 풀고, 끝나면 <em>«Beste simulakro bat sortu»</em>를 누르세요. 새 시험이 떨어집니다.' },
};
const c = COPY[locale] ?? COPY.es!;
---
<RootLayout locale={locale} title={c.title}>
  <article class="container sim-page">
    <header class="sim-header stagger">
      <p class="eyebrow">
        <a href={`/${locale}/${level}/`}>{c.back}</a>
      </p>
      <h1 class="display">🎲 Simulakro <span class="text-grad">sortzailea</span></h1>
      <p class="sim-lead" set:html={c.lead} />
    </header>
    <SimulakroGenerator client:only="svelte" locale={locale} />
  </article>
</RootLayout>

<style>
  .sim-page { display: grid; gap: var(--s-6); padding-block: var(--s-6) var(--s-9); }
  .sim-header { display: grid; gap: var(--s-3); }
  .sim-lead { max-width: 62ch; line-height: 1.65; color: var(--c-text-muted); }
</style>
