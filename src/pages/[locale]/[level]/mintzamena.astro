const c = COPY[locale] ?? COPY.es!;
---
<RootLayout locale={locale} title={c.title}>
  <article class="container gym-page">
    <header class="gym-header stagger">
      <p class="eyebrow">
        <a href={`/${locale}/${level}/`}>{c.back}</a>
      </p>
      <h1 class="display">🎙️ Ahoskera-<span class="text-grad">gimnasioa</span>
        <span class="beta-tag">BETA</span></h1>
      <p class="gym-lead" set:html={c.lead} />
    </header>
    <MintzamenaGym client:only="svelte" locale={locale} />
  </article>
</RootLayout>

<style>
  .gym-page { display: grid; gap: var(--s-6); padding-block: var(--s-6) var(--s-9); max-inline-size: 760px; }
  .gym-header { display: grid; gap: var(--s-3); }
  .gym-lead { line-height: 1.65; color: var(--c-text-muted); }
  .gym-warn {
    background: var(--c-red-soft); border-left: 3px solid var(--c-red);
    border-radius: var(--r-sm); padding: var(--s-2) var(--s-3); font-size: 0.92rem;
  }
  .beta-tag {
    display: inline-block; vertical-align: middle;
    font-size: 0.85rem; font-weight: 700; letter-spacing: 0.08em;
    background: var(--c-red); color: #fff;
    padding: 2px 10px; border-radius: 999px; margin-inline-start: var(--s-2);
  }
</style>
