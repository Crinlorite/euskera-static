---
// Ahoskera-gimnasioa (BETA): mintzamena con reconocimiento de voz EN EL
// NAVEGADOR — en los 18 idiomas desde el 03-ago-2026. El copy de ESTA página
// vive aquí (copy de página, no UI compartida).
import RootLayout from '../../../layouts/RootLayout.astro';
import MintzamenaGym from '../../../components/exercises/MintzamenaGym.svelte';
import { ACTIVE_LOCALES } from '../../../i18n/config';
import type { LocaleCode } from '../../../i18n/config';

export function getStaticPaths() {
  return ACTIVE_LOCALES.map((code) => ({ params: { locale: code, level: 'a1' } }));
}

const { locale, level } = Astro.params as { locale: LocaleCode; level: string };

