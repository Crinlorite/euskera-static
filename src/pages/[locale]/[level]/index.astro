---
import { getCollection } from 'astro:content';
import RootLayout from '../../../layouts/RootLayout.astro';
import { ACTIVE_LOCALES, type LocaleCode } from '../../../i18n/config';
import { t } from '../../../i18n/ui';

export async function getStaticPaths() {
  const allLevels = await getCollection('levels');
  return allLevels
    .filter((l) => ACTIVE_LOCALES.some((loc) => l.id.startsWith(`${loc}/`)))
    .map((l) => {
      const [locale, code] = l.id.split('/');
      return { params: { locale, level: code }, props: { level: l } };
    });
}

const { locale, level: levelSlug } = Astro.params as { locale: LocaleCode; level: string };
const { level } = Astro.props;

const allUnits = await getCollection('units');
const units = allUnits
  .filter((u) => u.id.startsWith(`${locale}/${levelSlug}/`))
  .sort((a, b) => a.data.order - b.data.order);

const allLessons = await getCollection('lessons');
const lessonsByUnit = new Map<string, number>();
for (const u of units) {
  const count = allLessons.filter((l) => l.id.startsWith(`${locale}/${levelSlug}/${u.data.code}/`)).length;
  lessonsByUnit.set(u.data.code, count);
}

// Teasers del simulakro y el gimnasio (03-ago-2026: abiertos a los 18 idiomas).
// Copy de página: vive aquí, no en ui.ts.
type Teasers = { sim: string; gym: string };
const TEASERS: Partial<Record<LocaleCode, Teasers>> = {
  es: { sim: 'Un examen A1 completo distinto cada vez — con entzumena de voz real, lectura, gramática y escritura autocorregida.',
        gym: 'Pronuncia y comprueba si se te entiende — todo funciona en tu dispositivo, nada sale de él.' },
  ca: { sim: 'Un examen A1 complet diferent cada vegada — amb entzumena de veu real, lectura, gramàtica i escriptura autocorregida.',
        gym: 'Pronuncia i comprova si se t’entén — tot funciona al teu dispositiu, res no en surt.' },
  gl: { sim: 'Un exame A1 completo distinto cada vez — con entzumena de voz real, lectura, gramática e escritura autocorrixida.',
        gym: 'Pronuncia e comproba se se che entende — todo funciona no teu dispositivo, nada sae del.' },
  ast: { sim: 'Un esame A1 completu distintu cada vegada — con entzumena de voz nativa, llectura, gramática y escritura autocorrexida.',
        gym: 'Pronuncia y comprueba si se t’entiende — too funciona nel to preséu, nada sal d’él.' },
  an: { sim: 'Un examen A1 completo diferent cada vegada — con entzumena de voz real, lectura, gramatica y escritura autocorrechida.',
        gym: 'Pronuncia y compreba si se t’entiende — tot funciona en o tuyo dispositivo, cosa no en sale.' },
  oc: { sim: 'Un examen A1 complet diferent cada còp — amb entzumena de votz reala, lectura, gramatica e escritura autocorregida.',
        gym: 'Prononcia e verifica se te comprenon — tot fonciona sus ton aparelh, res ne sortís pas.' },
  en: { sim: 'A complete A1 exam, different every time — with real-voice entzumena, reading, grammar and auto-scored writing.',
        gym: 'Pronounce and check whether you can be understood — everything runs on your device, nothing leaves it.' },
  ar: { sim: 'امتحان A1 كامل مختلف في كل مرة — مع entzumena بصوت حقيقي، وقراءة وقواعد وكتابة بتصحيح تلقائي.',
        gym: 'انطق وتحقّق هل يمكن فهمك — كل شيء يعمل على جهازك، ولا يغادره شيء.' },
  fr: { sim: 'Un examen A1 complet, différent à chaque fois — avec entzumena en vraie voix, lecture, grammaire et écriture autocorrigée.',
        gym: 'Prononce et vérifie si l’on te comprend — tout tourne sur ton appareil, rien n’en sort.' },
  ro: { sim: 'Un examen A1 complet, diferit de fiecare dată — cu entzumena cu voce reală, citire, gramatică și scriere autocorectată.',
        gym: 'Pronunță și verifică dacă poți fi înțeles — totul rulează pe dispozitivul tău, nimic nu-l părăsește.' },
  'pt-BR': { sim: 'Uma prova A1 completa, diferente a cada vez — com entzumena de voz real, leitura, gramática e escrita autocorrigida.',
        gym: 'Pronuncie e confira se dá para te entender — tudo roda no seu aparelho, nada sai dele.' },
  de: { sim: 'Eine komplette A1-Prüfung, jedes Mal anders — mit entzumena in echter Stimme, Lesen, Grammatik und automatisch korrigiertem Schreiben.',
        gym: 'Sprich und prüf, ob man dich versteht — alles läuft auf deinem Gerät, nichts verlässt es.' },
  it: { sim: 'Un esame A1 completo, diverso ogni volta — con entzumena a voce reale, lettura, grammatica e scrittura autocorretta.',
        gym: 'Pronuncia e verifica se ti si capisce — tutto gira sul tuo dispositivo, nulla ne esce.' },
  ru: { sim: 'Полный экзамен A1, каждый раз другой — с entzumena с живым голосом, чтением, грамматикой и автопроверкой письма.',
        gym: 'Произнесите и проверьте, можно ли вас понять — всё работает на вашем устройстве и не покидает его.' },
  pl: { sim: 'Pełny egzamin A1, za każdym razem inny — z entzumena z prawdziwym głosem, czytaniem, gramatyką i automatycznie ocenianym pisaniem.',
        gym: 'Wymów i sprawdź, czy da się ciebie zrozumieć — wszystko działa na twoim urządzeniu i nic go nie opuszcza.' },
  'zh-Hans': { sim: '一份完整的 A1 试卷，每次都不一样——含真人语音的 entzumena、阅读、语法和自动批改的写作。',
        gym: '开口说说看能不能被听懂——一切都在你的设备上运行，什么都不会外传。' },
  ja: { sim: '毎回内容が変わる完全な A1 試験 — 本物の声の entzumena、読解、文法、自動採点の作文つき。',
        gym: '発音して「通じるか」をチェック — すべてあなたの端末内で動き、外には何も出ません。' },
  ko: { sim: '매번 다른 완전한 A1 시험 — 실제 목소리의 entzumena, 읽기, 문법, 자동 채점 작문 포함.',
        gym: '발음하고 알아들을 수 있는지 확인하세요 — 모두 당신 기기에서 돌아가고, 아무것도 밖으로 나가지 않아요.' },
};
const teasers = TEASERS[locale] ?? TEASERS.es!;
---
<RootLayout locale={locale} title={level.data.name}>
  <article class="container-wide level">
    <header class="level-header stagger">
      <p class="eyebrow">Nivel · {level.data.name.split(' ')[0]}</p>
      <h1 class="display level-h1">
        <span>{level.data.name.split(' ')[0]}</span>
        <span class="text-grad level-subtitle">{level.data.name.split(' ').slice(1).join(' ') || 'Maila'}</span>
      </h1>
      <p class="level-desc">{level.data.description}</p>
    </header>

    <section class="units-section">
      {units.length === 0 ? (
        <p class="empty">{t(locale, 'levels.upcoming')}</p>
      ) : (
        <ul class="unit-list">
          {units.map((u) => (
            <li class="unit-item">
              <a class="unit-card" href={`/${locale}/${levelSlug}/${u.data.code}/`}>
                <span class="unit-num display">{u.data.order.toString().padStart(2, '0')}</span>
                <div class="unit-body">
                  <h3 class="unit-title">{u.data.title}</h3>
                  <p class="unit-meta">
                    {lessonsByUnit.get(u.data.code) ?? 0} {t(locale, 'unit.lessons').toLowerCase()} · ~{u.data.estimatedMinutes} min
                  </p>
                </div>
                <span class="unit-arrow icon-direction-aware" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="22" height="22"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {levelSlug === 'a1' && (
        <>
          <a class="sim-cta" href={`/${locale}/${levelSlug}/simulakroa/`}>
            <span class="sim-cta-dice" aria-hidden="true">🎲</span>
            <span class="sim-cta-body">
              <strong>Simulakro sortzailea</strong>
              <small>{teasers.sim}</small>
            </span>
          </a>
          <a class="sim-cta gym" href={`/${locale}/${levelSlug}/mintzamena/`}>
            <span class="sim-cta-dice" aria-hidden="true">🎙️</span>
            <span class="sim-cta-body">
              <strong>Ahoskera-gimnasioa <span class="beta-mini">BETA</span></strong>
              <small>{teasers.gym}</small>
            </span>
          </a>
        </>
      )}
    </section>

    <section class="curriculum">
      <details class="curriculum-details">
        <summary>
          <span class="eyebrow">Currículum</span>
          <span class="curriculum-title-display display">Lo que vas a saber</span>
          <span class="curriculum-toggle-hint">{level.data.curriculum.length} puntos · pulsa para ver</span>
        </summary>
        <ul class="curriculum-list">
          {level.data.curriculum.map((c, i) => (
            <li>
              <span class="curriculum-num">{(i + 1).toString().padStart(2, '0')}</span>
              <span class="curriculum-title">{c.title}</span>
            </li>
          ))}
        </ul>
      </details>
    </section>
  </article>
</RootLayout>

<style>
  .level { padding-block: var(--s-8) var(--s-9); }

  .sim-cta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    align-items: center;
    margin-block-start: var(--s-5);
    padding: var(--s-4) var(--s-5);
    border: 2px solid var(--c-green);
    border-radius: var(--r-md);
    background: var(--c-green-soft);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .sim-cta:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgb(0 150 75 / 0.18); }
  .sim-cta-dice { font-size: 2rem; }
  .sim-cta-body { display: grid; gap: 2px; }
  .sim-cta-body strong { color: var(--c-green-deep); }
  .sim-cta-body small { color: var(--c-text-muted); }
  .sim-cta.gym { border-color: var(--c-red); background: var(--c-red-soft); }
  .sim-cta.gym:hover { box-shadow: 0 6px 18px rgb(213 43 30 / 0.16); }
  .sim-cta.gym strong { color: var(--c-red-deep); }
  .beta-mini {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em;
    background: var(--c-red); color: #fff; padding: 1px 7px;
    border-radius: 999px; vertical-align: middle; margin-inline-start: 4px;
  }

  .level-header { margin-block-end: var(--s-9); border-block-end: 1px solid var(--c-border); padding-block-end: var(--s-7); }
  .level-h1 {
    font-size: var(--t-display);
    line-height: 0.9;
    letter-spacing: var(--tr-display);
    margin: var(--s-2) 0 var(--s-4);
  }
  .level-h1 span { display: block; }
  .level-subtitle { font-style: italic; }
  .level-desc {
    font-family: var(--ff-sans);
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--c-text-muted);
    max-inline-size: 56ch;
    line-height: 1.55;
  }

  .section-head { margin-block-end: var(--s-6); display: grid; gap: var(--s-2); }
  .section-title {
    font-size: var(--t-h2);
    line-height: 1.05;
    letter-spacing: var(--tr-tight);
  }

  .units-section { margin-block-end: var(--s-9); }
  .empty { color: var(--c-text-muted); }

  .unit-list {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 760px) {
    .unit-list { grid-template-columns: repeat(2, 1fr); }
  }
  .unit-item { display: contents; }
  .unit-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--s-5);
    align-items: center;
    padding: var(--s-5) var(--s-6);
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--sh-card);
    transition: transform var(--m-base) var(--ease-out),
                box-shadow var(--m-base) var(--ease-out),
                border-color var(--m-base) var(--ease-out);
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .unit-card::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block: 0;
    inline-size: 4px;
    background: var(--grad-ikurri-edge);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--m-base) var(--ease-out);
  }
  .unit-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-card-hover);
    border-color: transparent;
  }
  .unit-card:hover::before { transform: scaleY(1); }
  .unit-card:hover .unit-arrow { transform: translateX(6px); }

  .unit-num {
    font-size: clamp(2.6rem, 5vw, 3.6rem);
    line-height: 1;
    padding-block: 0.06em;
    padding-inline: 0.14em;
    margin-inline-start: -0.12em;
    background: var(--grad-ikurri-text);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
  }
  .unit-body { display: grid; gap: var(--s-1); }
  .unit-title {
    margin: 0;
    font-family: var(--ff-sans);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .unit-meta { color: var(--c-text-muted); font-size: 0.92rem; margin: 0; }
  .unit-arrow {
    color: var(--c-red);
    transition: transform var(--m-base) var(--ease-out);
  }

  /* Curriculum colapsable */
  .curriculum-details {
    border: 1px solid var(--c-border);
    border-radius: var(--r-lg);
    background: var(--c-bg);
    box-shadow: var(--sh-card);
    overflow: hidden;
  }
  .curriculum-details summary {
    list-style: none;
    cursor: pointer;
    padding: var(--s-5);
    display: grid;
    gap: var(--s-2);
    align-items: baseline;
    transition: background var(--m-base) var(--ease-out);
  }
  .curriculum-details summary::-webkit-details-marker { display: none; }
  .curriculum-details summary:hover { background: var(--c-bg-alt); }
  .curriculum-details[open] summary { border-block-end: 1px solid var(--c-border); }
  .curriculum-title-display {
    font-size: var(--t-h2);
    line-height: 1.05;
    letter-spacing: var(--tr-tight);
  }
  .curriculum-toggle-hint {
    color: var(--c-text-muted);
    font-size: 0.9rem;
  }
  .curriculum-details[open] .curriculum-toggle-hint::after {
    content: ' (pulsa para ocultar)';
  }
  .curriculum-list {
    list-style: none;
    counter-reset: c;
    margin: 0;
    padding: var(--s-5);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--s-3);
  }
  .curriculum-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-2);
    padding: var(--s-2) var(--s-3);
    background: transparent;
    border-radius: var(--r-sm);
    border: 0;
    transition: background var(--m-fast) var(--ease-out);
    font-size: 0.9rem;
  }
  .curriculum-list li:hover {
    background: var(--c-bg-alt);
  }
  .curriculum-num {
    font-family: var(--ff-display);
    font-weight: 700;
    color: var(--c-red);
    font-size: 0.85rem;
    align-self: start;
    line-height: 1.5;
    min-inline-size: 1.8em;
  }
  .curriculum-title { color: var(--c-text); font-size: 0.9rem; line-height: 1.4; }

  @media (max-width: 720px) {
    .level { padding-block: var(--s-6); }
    .level-header { margin-block-end: var(--s-7); padding-block-end: var(--s-5); }
    .unit-card { padding: var(--s-4); gap: var(--s-3); }
    .curriculum-list { grid-template-columns: 1fr; }
  }
</style>
