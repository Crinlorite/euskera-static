---
import RootLayout from '../../layouts/RootLayout.astro';
import { ACTIVE_LOCALES, type LocaleCode } from '../../i18n/config';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: LocaleCode };
---
<RootLayout locale={locale} title={t(locale, 'about.title')}>
  <article class="container prose">
    <h1>{t(locale, 'about.title')}</h1>

    <p>{t(locale, 'about.intro')}</p>

    <h2>{t(locale, 'about.phil.title')}</h2>
    <ul>
      <li set:html={t(locale, 'about.phil.free')} />
      <li set:html={t(locale, 'about.phil.nologin')} />
      <li set:html={t(locale, 'about.phil.noads')} />
      <li set:html={t(locale, 'about.phil.opendata')} />
      <li set:html={t(locale, 'about.phil.eternal')} />
    </ul>

    <h2>{t(locale, 'about.sources.title')}</h2>
    <p>{t(locale, 'sources.statement')}</p>

    <h2>{t(locale, 'footer.licenses')}</h2>
    <ul>
      <li set:html={t(locale, 'about.license.code')} />
      <li set:html={t(locale, 'about.license.content')} />
    </ul>

    <h2>{t(locale, 'about.contribute.title')}</h2>

    <script>
      import('../../stores/progress').then(({ unlockAchievements }) => {
        unlockAchievements(['curiosity-about']);
      }).catch(() => {});
    </script>
    <p set:html={t(locale, 'about.contribute.body')} />
  </article>
</RootLayout>

<style>
  .prose { padding-block: var(--s-6); }
  .prose h1 { margin: 0 0 var(--s-4); }
  .prose h2 { margin-block: var(--s-6) var(--s-2); }
  .prose ul { padding-inline-start: var(--s-5); display: grid; gap: var(--s-2); }
</style>
